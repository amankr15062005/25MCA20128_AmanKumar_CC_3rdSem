class Solution {
    public int shipWithinDays(int[] weights, int days) {
        int low=0;
        int high=0;
        for(int weight:weights){
            low=Math.max(low,weight);
            high+=weight;
        }
        while(low<high){
            int mid=low+(high-low)/2;
            int requiredDay=1;
            int currentWeight=0;
            for(int weight:weights){
                if(currentWeight + weight >mid){
                    requiredDay++;
                    currentWeight=0;
                }
                currentWeight+=weight;
            }
            if(requiredDay<=days){
                high=mid;
            }
            else{
                low=mid+1;
            }
        }
        return low;
    }
}
